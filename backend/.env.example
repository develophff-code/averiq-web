PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://averiq_user:averiq_pass@localhost:5432/averiq_db?schema=public"

# Optional Email / Notification SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contacto@averiq.com
SMTP_PASS=tu_password_o_app_token
NOTIFY_EMAIL=contacto@averiq.com

# Optional server-side access token. Leave empty to disable /api/leads.
# Generate a token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADS_ADMIN_TOKEN=

# Shared allowance across both Gemini chats (requests per 24-hour window).
AI_DAILY_LIMIT=300
